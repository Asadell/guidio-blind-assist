# Salin ke .env lalu isi nilainya. JANGAN commit .env (sudah di .gitignore).

# ── Server ───────────────────────────────────────────────────────────────
PORT=8000
DEVICE=auto

# ── PostgreSQL ───────────────────────────────────────────────────────────
DATABASE_URL=
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=vinara_dev

# ── Model deteksi rintangan ─────────────────────────────────────────────
YOLO_MODEL=yolo11n.pt

# ── Model Cari Objek (YOLOE open-vocabulary) ────────────────────────────
YOLOE_MODEL=yoloe-11s-seg.pt
YOLOE_CONF=0.25

# ── Model segmentasi jalur 3 zona ───────────────────────────────────────
SEGMENTATION_MODEL=models/pidnet_s_3zona.onnx
SEGMENTATION_INPUT=512

# ── Model uang (opsional; jalur utama on-device .tflite) ────────────────
MONEY_MODEL=models/uang_mobilenetv3.onnx
MONEY_CONF_THRESHOLD=0.85

# ── Claude (Asisten Suara) ──────────────────────────────────────────────
ANTHROPIC_API_KEY=
