# Salin ke .env lalu sesuaikan nilainya. JANGAN commit .env (sudah di .gitignore).
#
# Backend ini stateless: tidak ada database, tidak ada kunci API, tidak ada
# layanan luar yang harus hidup lebih dulu. Yang tersisa hanya konfigurasi dua
# model yang tidak muat di ponsel.

# ── Model Cari Objek (YOLOE open-vocabulary) ────────────────────────────
YOLOE_MODEL=yoloe-11s-seg.pt

# Sengaja sangat kecil. Encoder teks YOLOE (MobileCLIP) menghasilkan skor jauh
# lebih rendah daripada YOLO closed-set: benda kecil seperti kunci berhenti di
# ~0.007, jadi threshold 0.25 membuatnya tidak pernah ditemukan.
YOLOE_CONF=0.001

# Ambang pelaporan (opsional). Default 0.01 di find_object_service.py.
# YOLOE_MIN_REPORT_CONF=0.01

# ── Deskripsi Suasana (Moondream2) ──────────────────────────────────────
# auto | cuda | cpu
MOONDREAM_DEVICE=auto
