# ==============================================================================
# GUIDIO App: Comprehensive Flutter & Testing .gitignore
# ==============================================================================

# Miscellaneous & System Junk
*.class
*.log
*.tmp
*.pyc
*.swp
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IDE & Editor Configs
*.iml
*.ipr
*.iws
.idea/
.vscode/

# Flutter / Dart Build & Package Artifacts
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
/coverage/

# Testing & Temporary Evaluation Artifacts
test/navigation/results/
test/navigation/samples/
test/navigation/eval_model.py
test/results/
test/samples/

# Symbolication & Obfuscation
app.*.symbols
app.*.map.json

# Android Studio & Gradle Artifacts
/android/app/debug
/android/app/profile
/android/app/release
android/.gradle/
android/captures/

# iOS Generated & Pods
**/ios/Flutter/.last_build_id
**/ios/Flutter/App.framework
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/Flutter/Generated.xcconfig
**/ios/Flutter/app.flttmp
**/ios/Flutter/flutter_export_environment.sh
**/ios/ServiceDefinitions.json
**/ios/Runner/GeneratedPluginRegistrant.h
**/ios/Runner/GeneratedPluginRegistrant.m
**/ios/Pods/

# Large Model Binaries (>50MB breaks GitHub file limit)
# assets/models/*.onnx
# assets/models/*.engine
# assets/models/*.pt
# assets/models/yolo11l_float32.tflite
# assets/models/yolo11n.tflite
assets/models/backup_models/
*_backup*.tflite
backup_*.tflite
# Foto uji dari kamera ponsel sendiri (test/fixtures/rupiah_mobile/, ~12 MB).
#
# Sengaja TIDAK di-commit: isinya foto uang milik pengembang, ukurannya besar,
# dan gunanya cuma untuk menyetel ambang di MoneyTFLiteService secara lokal.
# Sumber aslinya ada di <root repo>/test/rupiah/ - salin ulang dengan:
#   cp -r ../../test/rupiah/. test/fixtures/rupiah_mobile/
#
# Tanpa folder ini test/rupiah_kamera_e2e_test.dart melewati dirinya sendiri
# dengan pesan yang jelas, bukan gagal.
test/fixtures/rupiah_mobile/
